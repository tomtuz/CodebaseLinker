{
  "name": "cotext",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "cotext": "./dist/cli.js"
  },
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "author": "tomtuz",
  "license": "ISC",
  "description": "A CLI tool to aggregate codebase files for context generation",
  "keywords": [
    "cli",
    "codebase",
    "context",
    "aggregator"
  ],
  "scripts": {
    "dev": "tsx src/index.ts -d -v -c .cotext/test.config.ts",
    "bin": "tsx ./scripts/run_binary.ts",
    "build": "unbuild",
    "build-run": "unbuild && pnpm run dev",
    "start": "node ./dist/cli.mjs",
    "prepare": "unbuild",
    "prepublishOnly": "pnpm run build",
    "pack": "pnpm pack --pack-gzip-level=9 --pack-destination='bin/prebuilt'",
    "debug_build": "node dist/index.mjs -d -c .cotext/test.config.ts",
    "debug_build_external": "pnpm node dist/index.mjs -d -c E:/Tomo/ccm/tool_ai_agent_go/.cotext/cotext.config.ts",
    "debug_tsx": "tsx src/index.ts -d -c .cotext/test.config.ts",
    "debug_tsx_external": "tsx src/index.ts -d -c E:/Tomo/ccm/tool_ai_agent_go/.cotext/cotext.config.ts",
    "build_go": "go build -o bin/mybinary.exe main.go",
    "run_go": "go run ./src/go_house/main.go -path .",
    "dev:init": "tsx src/index.ts init",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "dep:check": "ncu --interactive --format group"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "minimatch": "^10.0.1",
    "picocolors": "^1.1.1",
    "tsx": "4.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/node": "^22.13.5",
    "@vitest/ui": "^3.0.7",
    "npm-check-updates": "^17.1.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "unbuild": "^3.5.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.7"
  },
  "packageManager": "pnpm@10.5.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
